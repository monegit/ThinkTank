{
  "name": "@think-tank/desktop",
  "version": "0.0.0",
  "private": true,
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --publish never",
    "build:dmg": "electron-vite build && electron-builder --mac dmg --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.thinktank.desktop",
    "productName": "ThinkTank",
    "beforeBuild": "./scripts/before-build.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": "dmg",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@think-tank/styles": "workspace:*",
    "@think-tank/tailwind-config": "workspace:*",
    "@think-tank/ui": "workspace:*",
    "lucide-react": "^1.47.0",
    "nativewind": "4.1.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.79.5",
    "react-native-web": "^0.20.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@think-tank/types": "workspace:*",
    "@think-tank/typescript-config": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "agentation": "^3.0.2",
    "electron": "^35.0.0",
    "electron-builder": "26",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
